{
  "sceneId": "prologue_bridge",
  "title": "Upper platform — the north mouth",
  "act": "prologue",
  "tier": "ambient",
  "participants": ["mara", "sera"],
  "entry": "sera_open",
  "once": true,
  "skippable": true,
  "availableWhen": { "kind": "flagSet", "flag": "pulse_tool_issued" },
  "nodes": [
    {
      "id": "sera_open",
      "speaker": "sera",
      "text": "Your tool just registered on the depot node. Check the charge before you go anywhere.",
      "duration": 6.0,
      "next": "mara_charge"
    },
    {
      "id": "mara_charge",
      "speaker": "mara",
      "text": "Half.",
      "duration": 1.0,
      "next": "sera_half"
    },
    {
      "id": "sera_half",
      "speaker": "sera",
      "text": "Half is enough. Don't survey anything between there and the gallery.",
      "duration": 5.2,
      "next": "mara_why_not"
    },
    {
      "id": "mara_why_not",
      "speaker": "mara",
      "text": "Why not?",
      "duration": 1.2,
      "next": "sera_units"
    },
    {
      "id": "sera_units",
      "speaker": "sera",
      "text": "The maintenance units read a survey pulse as a work order. They'll come and stand next to you until you cancel it.",
      "duration": 8.6,
      "next": "mara_noted",
      "interrupts": [
        {
          "event": "world.pump-cluster-b-desync",
          "target": "interrupt_bang",
          "earliest": 2.0
        }
      ]
    },
    {
      "id": "mara_noted",
      "speaker": "mara",
      "text": "Noted.",
      "duration": 1.0,
      "next": "sera_task"
    },
    {
      "id": "interrupt_bang",
      "speaker": "mara",
      "text": "That came from the channel.",
      "duration": 2.4,
      "next": "sera_bang_ack"
    },
    {
      "id": "sera_bang_ack",
      "speaker": "sera",
      "text": "Cluster B. It does that when a pump drops out of sync. Keep walking.",
      "duration": 5.6,
      "next": "sera_task"
    },
    {
      "id": "sera_task",
      "speaker": "sera",
      "text": "Three pumps at Cluster B. Two are down. I need someone standing at the third before I schedule anything.",
      "duration": 7.6,
      "next": "mara_twelve"
    },
    {
      "id": "mara_twelve",
      "speaker": "mara",
      "text": "Station Twelve.",
      "duration": 1.6,
      "next": "sera_gallery"
    },
    {
      "id": "sera_gallery",
      "speaker": "sera",
      "text": "The lower gallery, yes. The stair floods to the second landing. Use the north mouth.",
      "duration": 6.6,
      "next": "mara_paper"
    },
    {
      "id": "mara_paper",
      "speaker": "mara",
      "text": "I'll bring the paper.",
      "duration": 1.8,
      "next": "sera_gate"
    },
    {
      "id": "sera_gate",
      "speaker": "sera",
      "text": "Do. The gate at the north mouth lifts by hand. It's rated for two people, so take the strain slowly.",
      "duration": 8.6,
      "choices": [
        {
          "id": "c_tide",
          "text": "How long until the next surge band?",
          "target": "sera_tide",
          "effects": [
            { "kind": "setFlag", "flag": "mara_asked_tide_window", "value": true }
          ]
        },
        {
          "id": "c_inside",
          "text": "Who else is inside the seal?",
          "target": "sera_inside",
          "effects": [
            { "kind": "setFlag", "flag": "mara_asked_who_is_inside", "value": true }
          ]
        }
      ]
    },
    {
      "id": "sera_tide",
      "speaker": "sera",
      "text": "Nine hours to the first band. Less if the wind stays where it is.",
      "duration": 5.4,
      "next": "sera_sign_off"
    },
    {
      "id": "sera_inside",
      "speaker": "sera",
      "text": "Officially, nobody.",
      "duration": 3.6,
      "next": "sera_sign_off"
    },
    {
      "id": "sera_sign_off",
      "speaker": "sera",
      "text": "I'll be on this channel. Holt out.",
      "duration": 3.4,
      "next": null
    }
  ],
  "onEnd": [{ "kind": "setFlag", "flag": "sera_first_task_given", "value": true }]
}
