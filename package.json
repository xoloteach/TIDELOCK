{
  "name": "tidelock",
  "version": "0.1.0",
  "description": "A complete open-source Three.js narrative game built to scale from mobile WebGL2 to desktop WebGPU.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xoloteach/TIDELOCK.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:story": "playwright test tests/browser/story",
    "test:mobile": "playwright test tests/browser/mobile",
    "test:visual": "playwright test tests/visual",
    "test:saves": "vitest run tests/saves",
    "lint:assets": "tsx scripts/validate-assets.ts",
    "generate:icons": "tsx scripts/generate-icons.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm lint:assets && pnpm build",
    "ci": "pnpm verify && pnpm test:e2e"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "@pmndrs/detect-gpu": "6.0.19",
    "@recast-navigation/three": "0.43.1",
    "dexie": "4.4.5",
    "miniplex": "2.0.0",
    "nipplejs": "1.0.4",
    "recast-navigation": "0.43.1",
    "stats-gl": "4.2.3",
    "three": "0.185.1",
    "three-mesh-bvh": "0.9.14",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "@types/three": "0.185.4",
    "@webgpu/types": "^0.1.72",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "tsx": "4.23.12",
    "tweakpane": "4.0.5",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
